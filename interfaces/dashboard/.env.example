# Cypher dashboard (Next.js) environment configuration.
# Copy to .env.local and adjust. This file covers the frontend only — the
# Python backend has its own .env.example at the repo root.
#
# The dashboard reaches the backend exclusively over HTTP. It never imports a
# Python module, and no backend credential (LLM keys, Wazuh/Greenbone logins,
# AWS keys) belongs in this file: anything prefixed NEXT_PUBLIC_ is embedded
# in the browser bundle and is therefore public.

# Base URL of the FastAPI backend (interfaces/api/app.py).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to 1 to render illustrative SAMPLE data instead of calling the backend.
# Read at build time (NEXT_PUBLIC_ values are inlined), so rebuild after changing it.
# Intended for interface development and offline demos only. In this mode the
# UI shows a persistent "SAMPLE DATA" banner and tags every figure, because
# none of those numbers come from the FAIR engine. Leave unset in any
# environment where a reader could mistake the screen for a real result.
NEXT_PUBLIC_DEMO_MODE=
