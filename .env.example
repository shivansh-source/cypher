# Su₹aksha backend environment configuration.
# Copy to .env and fill in real values — .env is gitignored, this file is not.
# This file covers the Python backend only (schema/, infra/, core/, governance/,
# ai/, interfaces/api/, interfaces/cli/). The dashboard (interfaces/dashboard/)
# is a separate Next.js toolchain with its own .env*.local, not this file.

# --- interfaces/api (FastAPI) ---------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API (the dashboard's dev/prod URL).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- core/ (snapshot storage) ----------------------------------------------
# Where bitemporal aggregated snapshots are persisted. data/ and snapshots/
# are gitignored — never commit real telemetry or real rupee figures.
SNAPSHOT_STORE_PATH=./data/snapshots

# --- ai/ (LLM client, edges only — see CLAUDE.md principles 1 and 2) ------
# Groq (ai/groq_transport.py). The model must support tool calling.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- ai/jev_transport.py (TypeSafe AI's Jev, for typed decisions) ---------
# Not a chat model — see ai/jev_transport.py's module docstring. Used by
# interfaces/cli/riskctl.py's identity-resolution step, never by
# ai/chat.py or ai/intent_classifier.py. This is the only config
# ai/jev_transport.py reads.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# --- ai/chat.py + ai/sessions.py (the chat assistant) ---------------------
# Chat sessions are held in this process's memory only: they do not survive
# a restart and are not shared between API workers. Run a single worker, or
# put a shared store behind ai.sessions.InMemorySessionStore's interface.
CHAT_SESSION_TTL_MINUTES=60
CHAT_MAX_SESSIONS=200
# How many model/tool round trips one chat turn may take before the
# assistant answers with what it has.
CHAT_MAX_TOOL_ITERATIONS=6

# --- infra/connectors/nessus_connector.py (Tenable Nessus / Tenable.io) ---
NESSUS_BASE_URL=https://your-tenable-instance/nessus
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=

# --- infra/connectors/prowler_connector.py (CSPM: AWS/Azure/GCP) ----------
# Prowler itself runs as a one-shot CLI scan in CI (out-of-band) and pushes
# its raw output to the S3 bucket below — this connector only reads
# latest/prowler_connector.json from S3, it never calls a live Prowler
# process or cloud API itself. These credentials are for that CI job, not
# for this connector.
PROWLER_CLOUD_PROVIDER=aws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# --- infra/connectors/scoutsuite_connector.py (CSPM: AWS/Azure/GCP) -------
# Same pattern as Prowler above: ScoutSuite runs as a one-shot CLI scan in
# CI and pushes its JS-wrapped report to S3; this connector only reads
# latest/scoutsuite_connector.json. It has no env vars of its own — it
# reads the shared RAW_FINDINGS_BUCKET/AWS_REGION below.

# --- infra/connectors/_object_store.py (S3 raw-findings object store) ----
# Shared by every connector that reads/writes raw tool output to/from S3 —
# see infra/README.md's "Raw findings object store" section.
RAW_FINDINGS_BUCKET=
AWS_REGION=ap-south-1

# --- infra/connectors/wazuh_connector.py (EDR/SIEM: manager API) ----------
WAZUH_API_URL=https://your-wazuh-manager:55000
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=

# --- infra/connectors/wazuh_connector.py (EDR/SIEM: indexer, for alerts) -
WAZUH_INDEXER_URL=https://your-wazuh-indexer:9200
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=

# --- infra/connectors/greenbone_connector.py (OpenVAS/GVM) ----------------
GREENBONE_HOST=your-gvm-manager
GREENBONE_PORT=9390
GREENBONE_USERNAME=
GREENBONE_PASSWORD=

# --- infra/connectors/iam_connector.py (AWS IAM posture, via PMapper) -----
# Path to the JSON written by `pmapper analysis --output-type json`. The
# connector reads this file; it never runs pmapper itself.
IAM_PMAPPER_OUTPUT_PATH=

# --- core/declared_services.py (manually-declared business context) -------
# Optional. JSON declaring services[] (criticality, backup posture) and which
# assets they run on. Human-declared, not connector-observed. Example:
# core/declared/loanease_sandbox_services.json
DECLARED_SERVICES_PATH=

# --- infra/connectors/cmdb_connector.py (canonical asset identity) --------
CMDB_BASE_URL=https://your-cmdb-instance/api
CMDB_API_TOKEN=
# Alternative to the REST API above: a JSON inventory file. Takes precedence
# when set. Produce one for AWS with:
#   python -m infra.inventory.export_ec2_inventory --region ap-south-1 > inventory.json
CMDB_EXPORT_PATH=

# --- governance/attestations.py (manual attestation store) ---------------
# Append-only store of manual control attestations, read by
# ai/tools/get_framework_status.py and interfaces/cli/riskctl.py's
# framework-status command. data/ is gitignored, same as
# SNAPSHOT_STORE_PATH above.
ATTESTATION_STORE_PATH=./data/attestations.json

# --- infra/connectors/_identity_resolution.py (Jev-assisted identity merge log) ---
# Append-only store of every identity-merge decision interfaces/cli/riskctl.py's
# ingest command makes (merged or not), with its full evidence trail — see
# infra/connectors/_identity_resolution.py's MergeDecision. data/ is
# gitignored, same as SNAPSHOT_STORE_PATH above.
IDENTITY_RECONCILIATION_STORE_PATH=./data/identity_reconciliation.json

# --- infra/connectors/iam_connector.py (e.g. Azure AD/Entra, Okta) --------
IAM_PROVIDER=azure_ad
IAM_TENANT_ID=
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=

# --- infra/connectors/threat_intel_connector.py (EPSS + CISA KEV) ---------
# Both feeds are public; NVD_API_KEY is optional and only raises NVD rate limits.
EPSS_API_BASE_URL=https://api.first.org/data/v1/epss
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
NVD_API_KEY=

# --- infra/connectors/nmap_connector.py (network exposure) ----------------
NMAP_SCAN_TARGETS=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
